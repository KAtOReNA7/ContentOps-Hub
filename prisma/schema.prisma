generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Work {
  id             String           @id @default(cuid())
  externalId     String?
  title          String
  author         String?
  description    String
  coverUrl       String?
  coverFileName  String?
  category       String?
  currentPlays   Int?
  currentCtr     Float?
  currentFinish  Float?
  notes          String?
  status         WorkStatus       @default(imported)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  analyses        AnalysisResult[]
  identifications WorkIdentification[]
  ratings         WorkRating[]
  titleIntroGenerations WorkTitleIntroGeneration[]
  coverAssets     CoverAsset[]
  coverEvaluations WorkCoverEvaluation[]
}

model AnalysisResult {
  id            String   @id @default(cuid())
  workId        String
  score         Int
  grade         String
  summary       String
  titleIdeas    String
  introIdeas    String
  riskNotes     String
  createdAt     DateTime @default(now())
  work          Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model WorkIdentification {
  id              String   @id @default(cuid())
  workId          String
  candidatesJson  String
  finalMatchJson  String
  confidence      Float
  reason          String
  risksJson       String
  confirmed       Boolean  @default(false)
  confirmedTitle  String?
  confirmedAuthor String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  ratings WorkRating[]
  titleIntroGenerations WorkTitleIntroGeneration[]

  @@index([workId])
}

model WorkRating {
  id               String   @id @default(cuid())
  workId           String
  identificationId String?
  rating           String
  score            Float
  confidence       Float
  reasonsJson      String
  risksJson        String
  evidenceJson     String
  renameSuggestion String
  renameReason     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  work           Work                @relation(fields: [workId], references: [id], onDelete: Cascade)
  identification WorkIdentification? @relation(fields: [identificationId], references: [id], onDelete: SetNull)
  titleIntroGenerations WorkTitleIntroGeneration[]

  @@index([workId])
  @@index([identificationId])
}

model WorkTitleIntroGeneration {
  id                     String   @id @default(cuid())
  workId                 String
  identificationId        String?
  ratingId                String?
  shouldGenerateVariants  Boolean
  strategy                String
  strategyReason          String
  titleVariantsJson       String
  introVariantJson        String
  coverPromptsJson        String
  risksJson               String
  evidenceJson            String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  work           Work                @relation(fields: [workId], references: [id], onDelete: Cascade)
  identification WorkIdentification? @relation(fields: [identificationId], references: [id], onDelete: SetNull)
  rating         WorkRating?         @relation(fields: [ratingId], references: [id], onDelete: SetNull)

  @@index([workId])
  @@index([identificationId])
  @@index([ratingId])
}

model CoverAsset {
  id           String   @id @default(cuid())
  workId       String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  work        Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  evaluations WorkCoverEvaluation[]

  @@index([workId])
}

model WorkCoverEvaluation {
  id                String   @id @default(cuid())
  workId            String
  coverAssetId      String?
  score             Float
  rating            String
  strengthsJson     String
  weaknessesJson    String
  strategy          String
  reason            String
  confirmed         Boolean  @default(false)
  confirmedStrategy String?
  reviewNote        String?
  confirmedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  work       Work        @relation(fields: [workId], references: [id], onDelete: Cascade)
  coverAsset CoverAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@index([workId])
  @@index([coverAssetId])
}

enum WorkStatus {
  imported
  analyzed
  failed
}
