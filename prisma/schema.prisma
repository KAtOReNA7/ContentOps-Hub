generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Work {
  id             String           @id @default(cuid())
  externalId     String?
  title          String
  author         String?
  description    String
  coverUrl       String?
  coverFileName  String?
  category       String?
  currentPlays   Int?
  currentCtr     Float?
  currentFinish  Float?
  notes          String?
  status         WorkStatus       @default(imported)
  reviewStatus   String           @default("pending_review")
  finalTitle     String?
  finalIntro     String?
  finalCoverUrl  String?
  finalCoverAssetId String?
  finalCoverRenderId String?
  finalCoverSource String?
  reviewNote    String?
  reviewedAt    DateTime?
  reviewerName  String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  analyses        AnalysisResult[]
  identifications WorkIdentification[]
  ratings         WorkRating[]
  titleIntroGenerations WorkTitleIntroGeneration[]
  coverAssets     CoverAsset[]
  coverEvaluations WorkCoverEvaluation[]
  coverRenders     WorkCoverRender[]
  batchJobItems     BatchJobItem[]
  experimentResults WorkExperimentResult[]
  experimentReviews WorkExperimentReview[]
}

model AnalysisResult {
  id            String   @id @default(cuid())
  workId        String
  score         Int
  grade         String
  summary       String
  titleIdeas    String
  introIdeas    String
  riskNotes     String
  createdAt     DateTime @default(now())
  work          Work     @relation(fields: [workId], references: [id], onDelete: Cascade)
}

model WorkIdentification {
  id              String   @id @default(cuid())
  workId          String
  candidatesJson  String
  finalMatchJson  String
  confidence      Float
  reason          String
  risksJson       String
  confirmed       Boolean  @default(false)
  confirmedTitle  String?
  confirmedAuthor String?
  searchProvider  String   @default("mock")
  searchQuery     String   @default("")
  searchResultsJson String @default("[]")
  evidenceJson    String   @default("[]")
  riskHintsJson   String   @default("[]")
  sourceSummaryJson String @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  ratings WorkRating[]
  titleIntroGenerations WorkTitleIntroGeneration[]

  @@index([workId])
}

model WorkRating {
  id               String   @id @default(cuid())
  workId           String
  identificationId String?
  rating           String
  score            Float
  confidence       Float
  reasonsJson      String
  risksJson        String
  evidenceJson     String
  renameSuggestion String
  renameReason     String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  work           Work                @relation(fields: [workId], references: [id], onDelete: Cascade)
  identification WorkIdentification? @relation(fields: [identificationId], references: [id], onDelete: SetNull)
  titleIntroGenerations WorkTitleIntroGeneration[]

  @@index([workId])
  @@index([identificationId])
}

model WorkTitleIntroGeneration {
  id                     String   @id @default(cuid())
  workId                 String
  identificationId        String?
  ratingId                String?
  shouldGenerateVariants  Boolean
  strategy                String
  strategyReason          String
  titleVariantsJson       String
  introVariantJson        String
  coverPromptsJson        String
  risksJson               String
  evidenceJson            String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  work           Work                @relation(fields: [workId], references: [id], onDelete: Cascade)
  identification WorkIdentification? @relation(fields: [identificationId], references: [id], onDelete: SetNull)
  rating         WorkRating?         @relation(fields: [ratingId], references: [id], onDelete: SetNull)
  coverRenders   WorkCoverRender[]

  @@index([workId])
  @@index([identificationId])
  @@index([ratingId])
}

model CoverAsset {
  id           String   @id @default(cuid())
  workId       String
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String?
  sourceType   String   @default("local_upload")
  remoteUrl    String?
  status       String   @default("available")
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  work        Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  evaluations WorkCoverEvaluation[]
  renders     WorkCoverRender[]

  @@index([workId])
}

model WorkCoverEvaluation {
  id                String   @id @default(cuid())
  workId            String
  coverAssetId      String?
  score             Float
  rating            String
  strengthsJson     String
  weaknessesJson    String
  strategy          String
  reason            String
  confirmed         Boolean  @default(false)
  confirmedStrategy String?
  reviewNote        String?
  confirmedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  work       Work        @relation(fields: [workId], references: [id], onDelete: Cascade)
  coverAsset CoverAsset? @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)

  @@index([workId])
  @@index([coverAssetId])
}

model WorkCoverRender {
  id                    String   @id @default(cuid())
  workId                String
  coverAssetId          String?
  titleIntroGenerationId String?
  titleText             String
  strategy              String
  outputRatio           String
  prompt                String   @default("")
  provider              String   @default("local_sharp")
  outputPath            String?
  outputUrl             String?
  status                String   @default("success")
  errorMessage          String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  work                 Work                       @relation(fields: [workId], references: [id], onDelete: Cascade)
  coverAsset           CoverAsset?                @relation(fields: [coverAssetId], references: [id], onDelete: SetNull)
  titleIntroGeneration WorkTitleIntroGeneration?  @relation(fields: [titleIntroGenerationId], references: [id], onDelete: SetNull)

  @@index([workId])
  @@index([coverAssetId])
  @@index([titleIntroGenerationId])
}

model BatchJob {
  id                  String   @id @default(cuid())
  type                String
  status              String   @default("pending")
  totalCount          Int      @default(0)
  successCount        Int      @default(0)
  failedCount         Int      @default(0)
  skippedCount        Int      @default(0)
  createdAt           DateTime @default(now())
  startedAt           DateTime?
  finishedAt          DateTime?
  createdBy           String?
  note                String?
  costRiskAccepted    Boolean  @default(false)
  providerSummaryJson String?
  errorSummary        String?
  items               BatchJobItem[]

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model BatchJobItem {
  id                String   @id @default(cuid())
  batchJobId        String
  workId            String
  step              String
  status            String   @default("pending")
  errorMessage      String?
  errorCode         String?
  resultSummaryJson String?
  startedAt         DateTime?
  finishedAt        DateTime?
  retryCount        Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  batchJob BatchJob @relation(fields: [batchJobId], references: [id], onDelete: Cascade)
  work     Work     @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@index([batchJobId])
  @@index([workId])
  @@index([status])
  @@index([step])
}

model WorkExperimentResult {
  id                String   @id @default(cuid())
  workId            String
  experimentName    String?
  groupType         String
  variantName       String?
  title             String
  intro             String?
  coverUrl          String?
  coverSource       String?
  exposureCount     Int?
  clickCount        Int?
  ctr               Float?
  playCount         Int?
  conversionCount   Int?
  conversionRate    Float?
  finishRate        Float?
  revenue           Float?
  testStartDate     DateTime?
  testEndDate       DateTime?
  dataSource        String?
  importedAt        DateTime @default(now())
  note              String?

  work Work @relation(fields: [workId], references: [id], onDelete: Cascade)
  controlReviews WorkExperimentReview[] @relation("ControlExperimentResult")
  winnerReviews  WorkExperimentReview[] @relation("WinnerExperimentResult")

  @@index([workId])
  @@index([experimentName])
  @@index([groupType])
  @@index([importedAt])
}

model WorkExperimentReview {
  id                 String   @id @default(cuid())
  workId             String
  experimentName     String
  controlResultId    String
  winnerResultId     String?
  conclusion         String
  recommendation     String
  ctrLift            Float?
  ctrLiftRate        Float?
  conversionLift     Float?
  conversionLiftRate Float?
  finishRateLift     Float?
  revenueLift        Float?
  confidenceLevel    String
  riskNotesJson      String?
  evidenceJson       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  work          Work                  @relation(fields: [workId], references: [id], onDelete: Cascade)
  controlResult WorkExperimentResult  @relation("ControlExperimentResult", fields: [controlResultId], references: [id], onDelete: Cascade)
  winnerResult  WorkExperimentResult? @relation("WinnerExperimentResult", fields: [winnerResultId], references: [id], onDelete: SetNull)

  @@index([workId])
  @@index([experimentName])
  @@index([recommendation])
  @@index([confidenceLevel])
}

enum WorkStatus {
  imported
  analyzed
  failed
}
